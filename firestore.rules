rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validTask(data) {
      return data.keys().hasAll(['title','dueDate','project','done','createdAt','updatedAt'])
        && data.keys().hasOnly(['title','dueDate','project','done','createdAt','updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.dueDate is string && data.dueDate.size() <= 10
        && (data.dueDate == '' || data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.project is string && data.project in ['', 'ВЦ', 'Эко', 'Личное']
        && data.done is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{uid}/tasks/{taskId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && validTask(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid) && validTask(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }
  }
}
