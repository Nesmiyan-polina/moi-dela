// Prototype schema: private tasks, their steps and comments, and planning settings.
// Older tasks may omit the new planning fields.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validDate(value) {
      return value is string && value.size() <= 10
        && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function validTask(data) {
      return data.keys().hasAll(['title','dueDate','project','done','createdAt','updatedAt'])
        && data.keys().hasOnly(['title','dueDate','project','done','createdAt','updatedAt','priority','estimateMin','repeat','remindAt','plannedDate','repeatAnchor'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && validDate(data.dueDate)
        && data.project is string && data.project.size() <= 80
        && data.done is bool
        && data.get('priority','') in ['', 'high', 'medium', 'low']
        && data.get('estimateMin',0) is int && data.get('estimateMin',0) >= 0 && data.get('estimateMin',0) <= 1440
        && data.get('repeat','') in ['', 'daily', 'weekly', 'monthly']
        && data.get('remindAt','') is string && data.get('remindAt','').size() <= 40
        && (data.get('remindAt','') == '' || data.get('remindAt','').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*Z$'))
        && validDate(data.get('plannedDate',''))
        && data.get('repeatAnchor',0) is int && data.get('repeatAnchor',0) >= 0 && data.get('repeatAnchor',0) <= 31
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validSubtask(data) {
      return data.keys().hasAll(['text','done','createdAt','updatedAt'])
        && data.keys().hasOnly(['text','done','createdAt','updatedAt'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 160
        && data.done is bool && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validComment(data) {
      return data.keys().hasAll(['text','createdAt'])
        && data.keys().hasOnly(['text','createdAt'])
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }
    function validPlanning(data) {
      return data.keys().hasAll(['capacityMin','updatedAt'])
        && data.keys().hasOnly(['capacityMin','updatedAt'])
        && data.capacityMin is int && data.capacityMin >= 60 && data.capacityMin <= 960
        && data.updatedAt is timestamp;
    }
    function validProject(data) {
      return data.keys().hasAll(['name','createdAt','updatedAt'])
        && data.keys().hasOnly(['name','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /users/{uid}/tasks/{taskId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && validTask(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid) && validTask(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
      match /subtasks/{subtaskId} {
        allow get, list: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)/tasks/$(taskId));
        allow create: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)/tasks/$(taskId))
          && validSubtask(request.resource.data) && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)/tasks/$(taskId))
          && validSubtask(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)/tasks/$(taskId));
      }
      match /comments/{commentId} {
        allow get, list: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)/tasks/$(taskId));
        allow create: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)/tasks/$(taskId))
          && validComment(request.resource.data) && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)/tasks/$(taskId));
      }
    }
    match /users/{uid}/settings/planning {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPlanning(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/projects/{projectId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && validProject(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid) && validProject(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
    }
  }
}
